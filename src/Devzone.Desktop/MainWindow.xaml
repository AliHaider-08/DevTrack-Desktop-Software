<Window x:Class="Devzone.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevTrack | Business Management" Height="800" Width="1360" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource PrimaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,22">
                    <TextBlock FontSize="24" FontWeight="Bold" FontFamily="Segoe UI Semibold" Text="DEVTRACK">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#292B25" Offset="0" />
                                <GradientStop Color="#648064" Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="BUSINESS WORKSPACE" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="1,3,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="DevTrack  ·  Local workspace" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="4,20,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavigationPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Background="#FFF7EB">
            <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Local mode" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <TextBlock x:Name="CompanyLabel" Text="Company" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock x:Name="UserLabel" Text="User" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28">
                    <TextBlock x:Name="PageHeading" Text="Dashboard" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageDescription" Text="Business data from your local workspace." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,22" />
                    <TextBlock x:Name="StatusMessage" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel x:Name="MainContent" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
